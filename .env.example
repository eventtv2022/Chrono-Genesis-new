# TimeNation — Chrono-Genesis environment variables
# Copy relevant values into Replit Secrets (never commit actual secrets)

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=your-session-secret-here

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAF...

# ── Google (TTS + Sheets + Gemini) ────────────────────────────────────────────
GOOGLE_API_KEY=AIza...                    # Gemini AI (manifesto + cinematic prompts)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  # Cloud TTS + Sheets
GOOGLE_SHEETS_ID=1BxiMVs...              # Spreadsheet ID for export logs

# ── AI Video Generation ───────────────────────────────────────────────────────
# Optional: HuggingFace API token for higher rate limits on text-to-video-ms-1.7b
# Without this token, requests use free-tier limits (may queue longer).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ── Crypto Payments (Cryptomus) ───────────────────────────────────────────────
CRYPTOMUS_MERCHANT_ID=...
CRYPTOMUS_API_KEY=...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_TELEGRAM_ID=123456789             # Numeric Telegram ID for /migratedata command
